        <module>common</module>
        <module>order-module</module>
        <module>shipment-module</module>
        <module>incident-module</module>
    </modules>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.sad</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sad</groupId>
                <artifactId>order-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sad</groupId>
                <artifactId>shipment-module</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sad</groupId>
                <artifactId>incident-module</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>